# ==============================================================================
# Amar Khobor Environment Configuration
# All APIs, URLs, models, voices, and MongoDB Atlas credentials are configured here.
# No code changes are required when switching providers, models, or endpoints.
# ==============================================================================

# --- STT Providers (Speech-to-Text) ---
# Active provider: "saaras" (Indic specialist) or "whisper" (Groq baseline)
STT_PROVIDER=saaras

# Sarvam Saaras Configuration
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text
SARVAM_MODEL=saaras:v4

# Groq Whisper Configuration
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
WHISPER_MODEL=whisper-large-v3

# --- LLM: Gemma (Morning Digest Summarizer & Code-Mixed LLM-Judge) ---
# Model: gemma-4-26b-a4b-it
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional custom gateway/endpoint URL (e.g. for Groq, OpenRouter, or Ollama)
LLM_API_URL=
LLM_PROVIDER=google

# --- TTS Providers (Text-to-Speech) ---
# Active engine: "edge-tts" (recommended for dev/testing) or "elevenlabs" (for demo showcase)
TTS_ENGINE=edge-tts

# ElevenLabs Configuration (Demo Showcase)
# Models: eleven_v4_turbo (active) or eleven_flash_v2_5
ELEVENLABS_API_KEY=
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1/text-to-speech
ELEVENLABS_MODEL_ID=eleven_v4_turbo
ELEVENLABS_VOICE_ID=Y8AULI9gwzMzFX41r7IP

# Edge-TTS Configuration (Development Tier - Free Neural Voices)
EDGE_TTS_VOICE=bn-IN-BashkarNeural

# --- Database: MongoDB Atlas ---
# Paste your MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=

# --- Operational Flags ---
# Set MOCK_MODE=false to enable live external network calls
MOCK_MODE=true
